{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": [
        ".eslintrc.js",
        ".eslintignore",
        ".prettierrc.yaml",
        "tsconfig.base.json",
        "tsconfig.build.json",
        "tsconfig.json"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
        },
        "clean:build": {
            "outputs": []
        },
        "dev": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "lint:fix": {},
        "format": {},
        "format:fix": {},
        "release": {},
        "test": {
            "dependsOn": ["build"]
        },
        "test:coverage": {
            "dependsOn": ["build"],
            "outputs": ["coverage/**"]
        },
        "tsc": {
            "outputs": ["tsconfig.tsbuildinfo"]
        }
    }
}
